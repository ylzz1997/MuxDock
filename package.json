{
  "name": "muxdock",
  "displayName": "MuxDock",
  "description": "%extension.description%",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#102335",
    "theme": "dark"
  },
  "version": "0.0.15",
  "publisher": "muxdock",
  "repository": {
    "type": "git",
    "url": "https://github.com/ylzz1997/MuxDock.git"
  },
  "homepage": "https://github.com/ylzz1997/MuxDock#readme",
  "bugs": {
    "url": "https://github.com/ylzz1997/MuxDock/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "tmux",
    "psmux",
    "zmx",
    "screen",
    "zellij",
    "shpool",
    "abduco",
    "sessions",
    "persistent",
    "multiplexer",
    "herdr"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "muxdock",
          "title": "MuxDock",
          "icon": "media/muxdock.svg"
        }
      ]
    },
    "views": {
      "muxdock": [
        {
          "type": "webview",
          "id": "muxdock.dock",
          "name": "MuxDock",
          "contextualTitle": "MuxDock"
        }
      ]
    },
    "commands": [
      {
        "command": "muxdock.open",
        "title": "%command.open%"
      },
      {
        "command": "muxdock.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "muxdock.newSession",
        "title": "%command.newSession%",
        "icon": "$(add)"
      },
      {
        "command": "muxdock.settings",
        "title": "%command.settings%",
        "icon": "$(gear)"
      },
      {
        "command": "muxdock.logs",
        "title": "%command.logs%"
      },
      {
        "command": "muxdock.language",
        "title": "%command.language%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "muxdock.newSession",
          "when": "view == muxdock.dock",
          "group": "navigation@1"
        },
        {
          "command": "muxdock.refresh",
          "when": "view == muxdock.dock",
          "group": "navigation@2"
        },
        {
          "command": "muxdock.settings",
          "when": "view == muxdock.dock",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "MuxDock",
      "properties": {
        "muxdock.language": {
          "type": "string",
          "scope": "window",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-cn",
            "zh-tw",
            "ja",
            "ko",
            "de",
            "fr",
            "es",
            "pt-br",
            "ru"
          ],
          "enumItemLabels": [
            "%config.language.auto%",
            "English",
            "简体中文",
            "繁體中文",
            "日本語",
            "한국어",
            "Deutsch",
            "Français",
            "Español",
            "Português (Brasil)",
            "Русский"
          ],
          "description": "%config.language%"
        },
        "muxdock.showTabs": {
          "type": "boolean",
          "default": true,
          "description": "%config.showTabs%"
        },
        "muxdock.maxTabs": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "description": "%config.maxTabs%"
        },
        "muxdock.visibleManagers": {
          "type": "array",
          "default": [
            "tmux",
            "psmux",
            "zmx",
            "screen",
            "zellij",
            "herdr",
            "shpool",
            "abduco",
            "a4"
          ],
          "items": {
            "type": "string",
            "enum": [
              "tmux",
              "psmux",
              "zmx",
              "screen",
              "zellij",
              "herdr",
              "shpool",
              "abduco",
              "a4"
            ]
          },
          "uniqueItems": true,
          "description": "%config.visibleManagers%"
        },
        "muxdock.showUnavailable": {
          "type": "boolean",
          "default": false,
          "description": "%config.showUnavailable%"
        },
        "muxdock.refreshInterval": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 60,
          "description": "%config.refreshInterval%"
        },
        "muxdock.fontSize": {
          "type": "number",
          "default": 12,
          "minimum": 8,
          "maximum": 40,
          "description": "%config.fontSize%"
        },
        "muxdock.fontFamily": {
          "type": "string",
          "default": "",
          "description": "%config.fontFamily%"
        },
        "muxdock.scrollback": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "%config.scrollback%"
        },
        "muxdock.executables": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "%config.executables%"
        },
        "muxdock.arguments": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "%config.arguments%"
        },
        "muxdock.defaultDirectory": {
          "type": "string",
          "default": "",
          "description": "%config.defaultDirectory%"
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/native-permissions.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx test/integration.ts",
    "test:windows": "tsx test/windows-capabilities.ts",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:links": "node scripts/test-links.mjs",
    "icon:build": "node scripts/render-icon.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies --out artifacts/",
    "test:windows:integration": "tsx test/windows-integration.ts",
    "test:ui:windows": "node scripts/ui-windows.mjs",
    "test:windows:new-backends": "tsx test/windows-new-backends.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.1.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
