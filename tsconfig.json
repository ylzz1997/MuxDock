{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "webview/**/*.ts",
    "test/**/*.ts"
  ]
}
